<mujoco model="rebot_b601_dm_phase4a_identification">
  <include file="rebot_dm.xml"/>

  <!--
    Phase 4A uses an explicit collision-free 0.05 m gripper lock on both prismatic joints.
    The lock retains gripper_link, gripper_left, and gripper_right mass/inertia.
  -->
  <equality>
    <joint name="gripper_left_lock" joint1="gripper_joint1" polycoef="0.05 0 0 0 0"
           solimp="0.9999 0.9999 0.001" solref="0.001 1"/>
    <joint name="gripper_right_lock" joint1="gripper_joint2" polycoef="0.05 0 0 0 0"
           solimp="0.9999 0.9999 0.001" solref="0.001 1"/>
  </equality>

  <keyframe>
    <key name="identification_home" qpos="0 -1.0 -1.0 0 0 0 0.05 0.05" ctrl="0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
